# IMP-02 — UAT trusted edge environment template. NO real secrets in this file.
#
# Every value below is either:
#   (a) a deployment-specific placeholder (bind address, upstream address) — not a numeric
#       policy value, or
#   (b) a REQUIRED BUT UNAPPROVED provisional value, explicitly labelled
#       PROVISIONAL — UAT ONLY — NOT APPROVED FOR PRODUCTION.
#
# Startup fails closed (haproxy -c / haproxy -f both abort) if any variable below is unset —
# see platform/edge/haproxy.base.cfg's ".if !defined(...)" guards. Governed rate/connection
# threshold NUMBERS (TOTAL/READ/MUTATE/aggregate) are NOT environment variables at all — they
# are literal, version-controlled values in platform/edge/uat/haproxy.limits.cfg, per
# docs/03_implementation/IMP-02/README.md (numbers must never be a deploy-time override).
#
# Copy this file to .env in this directory (git-ignored) and fill in real values for local UAT.

# ---------------------------------------------------------------------------------------------
# Secret — the trusted edge's own perimeter-provenance credential. Must be the SAME value
# configured on WLT-01 as WLT1_PUBLIC_PERIMETER_TOKEN (platform/.env.example). >=32 characters.
# Never sent to, or accepted from, a browser/mobile client — the edge strips any inbound copy
# and injects this trusted value itself (platform/edge/haproxy.base.cfg).
# ---------------------------------------------------------------------------------------------
WLT1_PUBLIC_PERIMETER_TOKEN=CHANGE_ME_EDGE_PERIMETER_TOKEN_PLACEHOLDER_32C

# ---------------------------------------------------------------------------------------------
# Deployment-specific — not numeric policy values.
# ---------------------------------------------------------------------------------------------
EDGE_BIND_ADDR=127.0.0.1
EDGE_BIND_PORT=18080
EDGE_WLT1_UPSTREAM_ADDR=127.0.0.1:8090

# ---------------------------------------------------------------------------------------------
# PROVISIONAL — UAT ONLY — NOT APPROVED FOR PRODUCTION
#
# These four values are required for the edge to function (client-facing timeouts and the
# connection ceiling can only live in the single frontend section — see haproxy.base.cfg's own
# comment on why they are env-guarded rather than moved to uat/haproxy.limits.cfg) but carry NO
# production approval. No M1-M8 measurement backs any of them.
#
# EDGE_BODY_LIMIT_BYTES: 65536 (64 KiB). WLT-01's public mutation payloads (wallet/payout
#   destination registration, PoC challenge/verify) are small JSON bodies — identifiers,
#   addresses, signatures. 64 KiB is generous headroom over any legitimate payload while
#   bounding pathological oversized bodies at the edge before they reach WLT-01.
EDGE_BODY_LIMIT_BYTES=65536

# EDGE_HEADER_TIMEOUT: 5s. Time to receive complete request headers ("timeout http-request").
#   Generous for legitimate clients over normal networks; tight enough to bound slow-header
#   (slowloris-style) resource holding during UAT abuse testing (A5).
EDGE_HEADER_TIMEOUT=5s

# EDGE_IDLE_TIMEOUT: 30s. Client-side idle/keep-alive bound ("timeout client"). A conventional
#   API-edge default; not derived from any measured AIX traffic pattern.
EDGE_IDLE_TIMEOUT=30s

# EDGE_CONN_LIMIT_PER_BUCKET: 50. The governed UAT concurrent-connection ceiling per source
#   bucket (IMP-02's provisional policy) — this one IS a fixed governed value, not an
#   implementation convenience; do not change it without a governance decision.
EDGE_CONN_LIMIT_PER_BUCKET=50
