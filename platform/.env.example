# FND-01 Platform Foundation — environment template. NO real secrets in this file.
# Startup fails closed if a required critical variable is missing (FND-FR-001, principle 5.2).

# Required (critical) — startup aborts if unset
ENVIRONMENT=dev                 # dev/qa/uat/staging/prod
DATABASE_URL=postgres://aix_fnd_runtime:CHANGE_ME@localhost:5432/aix_platform
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_PLACEHOLDER   # IAM handoff seam — interim internal-identity only

# Shared Rate-Limit Engine (WLT-01 BLOCKER-2 prerequisite, DEC-009) — required, startup aborts
# if unset. Flat JSON object mapping each consumer module id to its own dedicated capability
# secret guarding POST /foundation/rate-limit/check (distinct from INTERNAL_SERVICE_TOKEN
# above). Every value must be unique across module ids (module identity is derived from WHICH
# secret matched a presented token) and at least 16 characters. NO real credential below.
FND_RATE_LIMIT_CONSUMER_SECRETS={"WLT-01":"CHANGE_ME_WLT01_RATE_LIMIT_SECRET_PLACEHOLDER"}

# Optional (defaulted)
PORT=8080
RELEASE_VERSION=v0.0.0
ARTIFACT_HASH=sha256:unknown
BUILD_TIME_UTC=1970-01-01T00:00:00Z

# Tests: set to a disposable Postgres to enable DB-gated integration tests. Unit tests do not need it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aix_platform_test

# ---------------------------------------------------------------------------
# IAM-01 Authentication / MFA / Session — services/iam. NO real secrets here.
# IAM runs as its own process/env; it reuses ENVIRONMENT/DATABASE_URL/PORT above
# (point DATABASE_URL at a role with iam_runtime_grants.sql applied for IAM).
# ---------------------------------------------------------------------------

# Required (critical) — startup aborts if unset. IAM's OWN internal-identity seam
# (separate copy of the guard from FND's; see services/iam/src/plugins/internal-identity.ts).
IAM_INTERNAL_SERVICE_TOKEN=CHANGE_ME_IAM_INTERNAL_PLACEHOLDER

# First-admin bootstrap (interim break-glass; disabled by default). When enabled and no
# iam.user_identity rows exist yet, creates ONE interim admin identity that must change
# password + complete MFA enrolment before a full session is issued. Consumed after the
# first user_identity row exists (idempotent no-op on subsequent boots).
IAM_BOOTSTRAP_ENABLED=false
# IAM_BOOTSTRAP_ADMIN_IDENTIFIER=admin@example.com
# IAM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# Session TTLs (seconds). Defaulted per §5.8 pending final per-user-class values (open item);
# iam.session_policy seeds sensible per-user-class rows at migration time.
IAM_ACCESS_TOKEN_TTL_SECONDS=900
IAM_REFRESH_TOKEN_TTL_SECONDS=1209600

# Rate-limit / lockout thresholds (IAM-side; enforced against iam.account_lockout).
IAM_LOGIN_MAX_ATTEMPTS=5
IAM_LOGIN_LOCKOUT_MINUTES=15
IAM_MFA_MAX_ATTEMPTS=5
IAM_MFA_LOCKOUT_MINUTES=15
IAM_PASSWORD_RESET_MAX_ATTEMPTS=5
IAM_PASSWORD_RESET_LOCKOUT_MINUTES=30
IAM_REFRESH_MAX_ATTEMPTS=20
IAM_REFRESH_LOCKOUT_MINUTES=15

# MFA TOTP secret envelope encryption passphrase (placeholder pending real KMS/HSM — see
# IAM-01_IMPLEMENTATION_NOTES.md). Defaults to an obviously-fake dev value; override in
# every real environment.
# IAM_MFA_SECRET_ENC_KEY=CHANGE_ME_MFA_SECRET_ENCRYPTION_PASSPHRASE
